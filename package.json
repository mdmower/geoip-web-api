{
  "name": "geoip-web-api",
  "version": "4.1.2",
  "description": "An AMP-GEO compatible location web API",
  "type": "module",
  "scripts": {
    "build": "npm run check-formatting && npm run lint && npm run clean && npm run compile",
    "check-formatting": "oxfmt --check",
    "clean": "rimraf lib",
    "compile": "tsc --project src/tsconfig.json",
    "compile:debug": "tsc --project src/tsconfig.json --sourceMap",
    "dev": "tsx --watch src/cli.ts --config config.dev.json",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "npm run clean && npm run compile",
    "start": "node lib/cli.js",
    "test": "vitest"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "bin": {
    "geoip-web-api": "lib/cli.js"
  },
  "files": [
    "/lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdmower/geoip-web-api.git"
  },
  "keywords": [
    "geoip",
    "amp-geo",
    "location",
    "maxmind"
  ],
  "author": "Matt Mower <mdmower@cmphys.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mdmower/geoip-web-api/issues"
  },
  "homepage": "https://github.com/mdmower/geoip-web-api#readme",
  "allowScripts": {
    "esbuild": true
  },
  "dependencies": {
    "express": "^5.2.1",
    "ip2ldb-reader": "^5.0.1",
    "maxmind": "^5.0.6",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.19.43",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
